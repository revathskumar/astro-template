---
// Component imports
import { Layout } from "@globals"

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
---

<Layout title="Title">
  <div class="flex w-full">
    <div class="min-h-svh flex items-center justify-center w-full">
      <div class="flex-col flex gap-2 w-full md:w-[50%] items-center">
        <Card className="w-full max-w-sm">
          <CardHeader>
            <CardTitle className="text-center">Card Title</CardTitle>
          </CardHeader>
          <CardDescription className="text-center py-2">
            Card description
          </CardDescription>
          <CardContent> Card Content </CardContent>
        </Card>
      </div>
    </div>
  </div>
</Layout>
